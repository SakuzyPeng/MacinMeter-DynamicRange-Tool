#!/usr/bin/env bash
# Fast, offline guard for the trusted workspace.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] checking repository identity"
python3 scripts/check-repository-contract.py

echo "[pre-commit] checking workspace formatting"
cargo fmt --all -- --check

echo "[pre-commit] checking workspace compilation"
cargo check --locked --workspace

echo "[pre-commit] passed"
