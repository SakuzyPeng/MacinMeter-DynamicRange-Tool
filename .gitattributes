# Working-tree bytes are identity in this repository: generator scripts hash
# their own bytes into the corpora and records they produce, and fixture and
# record digests are compared across hosts. Line endings therefore may not
# depend on which platform a checkout happened on, so text is normalized to LF
# in the working tree everywhere rather than left to `core.autocrlf`.
* text=auto eol=lf

# Fixture and reference media are byte-pinned by SHA-256 in their manifests.
# Content detection would already classify these as binary; saying so leaves
# nothing to detection.
*.wav binary
*.aif binary
*.aiff binary
*.flac binary
*.m4a binary
*.mp4 binary
*.png binary
*.bin binary

# Reference evidence and reverse-engineering harnesses are not product code.
reference/** linguist-detectable=false

# Committed measurement and reference artifacts are evidence, and the records
# that cite them quote their SHA-256 as identity. A tool that produced one on
# Windows writes CRLF; normalizing that would leave the record naming a digest
# no committed file has. Evidence is therefore stored exactly as produced. This
# is the opposite treatment from the source above, and deliberately so: source
# bytes must not depend on the checkout host, artifact bytes must not depend on
# anything at all.
docs/performance/baselines/*.json -text
docs/performance/comparisons/*.json -text
docs/performance/equivalence/*.json -text
docs/performance/probes/*.json -text
docs/performance/profiles/*.json -text
reference/conformance/**/*.json -text
reference/fixtures/*.manifest.json -text
reference/observations/**/*.json -text

# Raw reference exports are the bytes the reference host produced, CRLF
# included. Normalizing them would edit evidence, so they stay untouched.
reference/observations/**/raw/* -text
